{
  "mainSelector": "main",
  "identitySelector": "h1",
  "placeholderSelector": ".loading,.skeleton,[aria-busy=\"true\"]",
  "errorSelector": ".error-page",
  "timeoutMs": 20000,
  "stableWindowMs": 1000,
  "sampleIntervalMs": 250,
  "dynamicTitle": true,
  "expectedIdentity": "XRP (XRP) Price",
  "kinds": [
    "pair",
    "claim"
  ],
  "fieldSelectors": {
    "body": "#today > .content",
    "market": ".today-price-container",
    "supply": ".today-price-container .item:has(.icon.idx-2)"
  },
  "requiredFields": {
    "body": {
      "pattern": "circulating supply"
    },
    "market": {
      "pattern": "Circulating Supply"
    }
  }
}